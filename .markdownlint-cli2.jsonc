{
  "globs": ["docs/**/*.md", "docs/**/*.mdx", "README.md"],
  "ignores": ["docs/zh-CN/**", "docs/.i18n/**", "docs/reference/templates/**", "**/.local/**"],
  "config": {
    "default": true,

    "MD013": false,
    "MD025": false,
    "MD029": false,

    // MD051 (link-fragments) disabled here. markdownlint's slugify
    // strips `.` from headings (e.g. `agentskills.io` → `agentskillsio`)
    // whereas Mintlify's runtime uses github-slugger semantics where
    // `.` becomes `-` (`agentskills-io`). They disagree.
    // Our scripts/docs-link-audit.mjs runs the github-slugger
    // algorithm and checks fragments end-to-end including cross-file,
    // so MD051 here would just generate false positives.
    "MD051": false,

    // MD024 in siblings_only mode: identical heading text under
    // different parent sections is fine (design docs like
    // plan9-memory-supremacy.md legitimately re-use "Scientific
    // Basis" / "How It Works" across each section).
    "MD024": { "siblings_only": true },

    "MD033": {
      "allowed_elements": [
        "Note",
        "Info",
        "Tip",
        "Warning",
        "Card",
        "CardGroup",
        "Columns",
        "Steps",
        "Step",
        "Tabs",
        "Tab",
        "Accordion",
        "AccordionGroup",
        "CodeGroup",
        "Frame",
        "Callout",
        "ParamField",
        "ResponseField",
        "RequestExample",
        "ResponseExample",
        "img",
        "a",
        "br",
        "details",
        "summary",
        "p",
        "strong",
        "picture",
        "source",
        "Tooltip",
        "Check",
      ],
    },

    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
  },
}
