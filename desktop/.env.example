# =============================================================================
# Bitterbot Control UI — Environment Variables (DEV ONLY)
#
# This file is OPTIONAL and only read by the Vite dev server (`pnpm dev`).
# In production the gateway serves the Control UI itself at
# http://127.0.0.1:19001 and hands the browser its session token over
# /auth/session-token — no .env file, no token on disk.
# Copy this file only if you are developing the Control UI against a
# custom gateway.
# =============================================================================

# Gateway WebSocket URL the dev server's UI should connect to.
VITE_GATEWAY_URL=ws://127.0.0.1:19001

# Optional: a friendly client name that identifies this browser session in
# gateway logs. Useful when multiple Control UI instances share one gateway.
VITE_GATEWAY_CLIENT_NAME=bitterbot-control-ui
