{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aubaine.ai/protocol/v1/offer.schema.json",
  "title": "Aubaine Offer body v1",
  "description": "Body of an Envelope with type=offer (§4.2). Supplier terms; sku_description carries the spec-locked frozen spec.",
  "type": "object",
  "required": [
    "sku_canonical",
    "sku_description",
    "unit_price_usdc",
    "moq",
    "lead_time_days",
    "supplier_wallet",
    "supplier_a2a_url",
    "deposit_bps",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "sku_canonical": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|brand:.+)$" },
    "sku_description": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "unit_price_usdc": { "type": "number", "exclusiveMinimum": 0 },
    "moq": { "type": "integer", "minimum": 1 },
    "lead_time_days": { "type": "integer", "minimum": 0 },
    "supplier_wallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "supplier_a2a_url": { "type": "string", "format": "uri" },
    "deposit_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "expires_at": { "type": "integer", "minimum": 0 }
  }
}
