{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aubaine.ai/protocol/v1/commit.schema.json",
  "title": "Aubaine Commit bodies v1",
  "description": "Bodies for commit_request and commit_response Envelopes (§4.4, §7).",
  "$defs": {
    "eip3009_authorization": {
      "type": "object",
      "description": "EIP-3009 transferWithAuthorization, buyer_wallet -> supplier_wallet (§7.3).",
      "required": ["from", "to", "value", "validAfter", "validBefore", "nonce", "signature"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "value": { "type": "string", "description": "USDC smallest-unit (6dp) as decimal string" },
        "validAfter": { "type": "integer", "minimum": 0 },
        "validBefore": { "type": "integer", "minimum": 0 },
        "nonce": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
      }
    },
    "commit_request": {
      "type": "object",
      "required": [
        "syndicate_id",
        "sku_canonical",
        "unit_price_usdc",
        "supplier_wallet",
        "deposit_bps",
        "strike_deadline"
      ],
      "additionalProperties": false,
      "properties": {
        "syndicate_id": { "type": "string" },
        "sku_canonical": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|brand:.+)$" },
        "unit_price_usdc": { "type": "number", "exclusiveMinimum": 0 },
        "supplier_wallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "supplier_a2a_url": { "type": "string", "format": "uri" },
        "deposit_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "strike_deadline": { "type": "integer", "minimum": 0 }
      }
    },
    "commit_response": {
      "type": "object",
      "required": ["syndicate_id", "deposit_auth", "balance_auth", "reverified"],
      "additionalProperties": false,
      "properties": {
        "syndicate_id": { "type": "string" },
        "deposit_auth": { "$ref": "#/$defs/eip3009_authorization" },
        "balance_auth": { "$ref": "#/$defs/eip3009_authorization" },
        "reverified": { "const": true }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/commit_request" }, { "$ref": "#/$defs/commit_response" }]
}
