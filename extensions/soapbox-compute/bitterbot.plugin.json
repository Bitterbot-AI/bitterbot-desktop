{
  "id": "soapbox-compute",
  "name": "Soapbox Compute",
  "version": "0.3.0-rc.1",
  "description": "Isolated compute with a separate Base Sepolia wallet",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": { "type": "string", "enum": ["pilot", "participant"] },
      "binary": { "type": "string", "minLength": 1 },
      "repository": { "type": "string", "minLength": 1 },
      "stateDirectory": { "type": "string", "minLength": 1 }
    },
    "required": ["stateDirectory"]
  }
}
